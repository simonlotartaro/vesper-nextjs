# Required environment variables. Values live in Vercel → Settings →
# Environment Variables, never in the repository. Copy this file to
# .env.local for local development and fill it in there.

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend ────────────────────────────────────────────────────────────
# Server only.
RESEND_API_KEY=
# Signing secret of the webhook endpoint (whsec_…). Server only.
RESEND_WEBHOOK_SECRET=

# ── Analytics ─────────────────────────────────────────────────────────
# HMAC salt for the rate-limit key on /api/analytics/instagram-outbound.
# Any long random string; rotating it only resets rate-limit counters.
# Without it the endpoint answers 503 and records nothing — by design,
# because a predictable salt would make the hashed IP reversible.
ANALYTICS_IP_SALT=
